{
  // Copy this file to appsettings.json (same folder as the exe) and fill it in.
  // appsettings.json is git-ignored so passwords never get committed.

  // Use a read-only Oracle account if you can. The program only ever runs SELECTs.
  "ConnectionString": "User Id=YOUR_USER;Password=YOUR_PASSWORD;Data Source=YOUR_HOST:1521/YOUR_SERVICE",

  "Rules": {
    "MaxTimeCardHours": 8.0,
    "LongRunWorkCenters": [ "OTTO TSUGAMI B0385" ],
    "NoLaborWorkCenters": [ "OTTO TSUGAMI S206", "PREPACK" ],
    "CostTolerance": 0.50
  },

  "Excel": {
    "Enabled": true,
    // A mapped drive (P:) is not visible to a scheduled task that runs while you are logged off.
    // Use the UNC path instead, e.g. "\\\\fileserver\\share\\jeff\\CheckStatus\\WorkOrderChecks.xlsx".
    "Path": "P:\\jeff\\CheckStatus\\WorkOrderChecks.xlsx",
    "SheetName": "",
    "CheckMark": "✓",
    "WriteNotesColumn": true,
    "FallbackFolder": "output",
    "SaveRetries": 5,
    "SaveRetryDelaySeconds": 60
  },

  "Email": {
    "Enabled": true,
    // Office 365: smtp.office365.com, 587, StartTls, with a username/password (or an app password).
    // Internal relay: your mail server, usually port 25, Security "None", Username blank.
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "Security": "StartTls",
    "Username": "",
    // Prefer setting the environment variable WODC_Email__Password instead of putting it here.
    "Password": "",
    "From": "",
    "To": [ "" ],
    "AttachWorkbook": true
  },

  "LogFolder": "logs"
}
