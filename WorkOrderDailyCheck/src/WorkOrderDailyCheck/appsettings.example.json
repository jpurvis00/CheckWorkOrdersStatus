{
  // Copy this file to appsettings.json (same folder as the exe) and fill it in.
  // appsettings.json is git-ignored so passwords never get committed.

  // Use a read-only Oracle account if you can. The program only ever runs SELECTs.
  // Either "ConnectionString": "..." or the old programs' "ConnectionStrings": { "Default": "..." } works.
  "ConnectionStrings": {
    "Default": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=YOUR_HOST)(PORT=1521))(CONNECT_DATA=(SID=YOUR_SID)));User Id=YOUR_USER;Password=YOUR_PASSWORD;"
  },

  "Rules": {
    "MaxTimeCardHours": 8.0,
    "LongRunWorkCenters": [ "OTTO TSUGAMI B0385" ],
    "NoLaborWorkCenters": [ "OTTO TSUGAMI S206", "PREPACK" ],
    "CostTolerance": 0.50
  },

  "Excel": {
    "Enabled": true,
    // A mapped drive (P:) is not visible to a scheduled task that runs while you are logged off.
    // Use the UNC path instead. In JSON every \ must be doubled, so \\server\share becomes "\\\\server\\share".
    "Path": "P:\\jeff\\CheckStatus\\WorkOrderChecks.xlsx",
    "SheetName": "",
    "CheckMark": "✓",
    "WriteNotesColumn": true,
    "FallbackFolder": "output",
    "SaveRetries": 5,
    "SaveRetryDelaySeconds": 60
  },

  "Email": {
    "Enabled": true,
    // "Graph" = Microsoft 365 app registration (needs the Mail.Send application permission, admin-consented).
    // "Smtp"  = a mail server; fill in the Smtp* settings below instead.
    "Provider": "Graph",
    "From": "",                 // a real mailbox in your tenant; Graph sends as this mailbox
    "To": "",                   // one address, "a@x.com; b@x.com", or a list [ "a@x.com" ]
    "Graph": {
      "TenantId": "",
      "ClientId": "",
      // Prefer the environment variable WODC_Email__Graph__ClientSecret instead of putting it here.
      "ClientSecret": ""
    },
    "SmtpHost": "",
    "SmtpPort": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "AttachWorkbook": true
  },

  "LogFolder": "logs"
}
